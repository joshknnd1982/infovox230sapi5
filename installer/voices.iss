[Files]
; Each language's rule files, installed only if that language was chosen.
Source: "{#StageDir}\engine\AMRULES.IVX"; DestDir: "{app}\engine"; Components: am; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\BLRULES.IVX"; DestDir: "{app}\engine"; Components: bl; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\SPRULES.IVX"; DestDir: "{app}\engine"; Components: sp; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\DARULES.IVX"; DestDir: "{app}\engine"; Components: da; Flags: ignoreversion restartreplace uninsrestartdelete
