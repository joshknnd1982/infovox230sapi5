Source: "{#StageDir}\engine\duRULES.IVX"; DestDir: "{app}\engine"; Components: du; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\fiRULES.IVX"; DestDir: "{app}\engine"; Components: fi; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\Frrules.IVX"; DestDir: "{app}\engine"; Components: fr; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\Gerules.ivx"; DestDir: "{app}\engine"; Components: ge; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\ICRULES.IVX"; DestDir: "{app}\engine"; Components: ic; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\ITRULES.IVX"; DestDir: "{app}\engine"; Components: it; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\NORULES.IVX"; DestDir: "{app}\engine"; Components: no; Flags: ignoreversion restartreplace uninsrestartdelete
Source: "{#StageDir}\engine\Swrules.ivx"; DestDir: "{app}\engine"; Components: sw; Flags: ignoreversion restartreplace uninsrestartdelete

[InstallDelete]
; Runs before anything is copied, so re-running setup with a language
; cleared genuinely gives the disk space back, instead of leaving a rule
; file behind for a voice that is no longer published.
Type: files; Name: "{app}\engine\AMRULES.IVX"; Components: not am
Type: files; Name: "{app}\engine\BLRULES.IVX"; Components: not bl
Type: files; Name: "{app}\engine\SPRULES.IVX"; Components: not sp
Type: files; Name: "{app}\engine\DARULES.IVX"; Components: not da
Type: files; Name: "{app}\engine\darules.dll"; Components: not da
Type: files; Name: "{app}\engine\duRULES.IVX"; Components: not du
Type: files; Name: "{app}\engine\fiRULES.IVX"; Components: not fi
Type: files; Name: "{app}\engine\Frrules.IVX"; Components: not fr
Type: files; Name: "{app}\engine\Gerules.ivx"; Components: not ge
Type: files; Name: "{app}\engine\ICRULES.IVX"; Components: not ic
Type: files; Name: "{app}\engine\ITRULES.IVX"; Components: not it
Type: files; Name: "{app}\engine\NORULES.IVX"; Components: not no
Type: files; Name: "{app}\engine\Swrules.ivx"; Components: not sw

[INI]
; What was chosen, written where the catalogue will read it. Only the
; entries whose component is selected are written, and installed.ini is
; deleted and recreated on every run (see Infovox230SAPI.iss), so the
; file is always the current choice rather than the union of every choice
; ever made. Each key is the name the engine knows that voice by.
Filename: "{app}\installed.ini"; Section: "Languages"; Key: "American English"; String: "1"; Components: am
Filename: "{app}\installed.ini"; Section: "Languages"; Key: "British English"; String: "1"; Components: bl
Filename: "{app}\installed.ini"; Section: "Languages"; Key: "Castilian Spanish"; String: "1"; Components: sp
